PORT=3000
# MongoDB Atlas — copia tu cadena SRV desde Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/smart-ticket?retryWrites=true&w=majority
NODE_ENV=development
# Claves DER codificadas en base64. La privada usa PKCS8 y la pública SPKI.
QR_ED25519_PRIVATE_KEY=clave-privada-ed25519-pkcs8-en-base64
QR_ED25519_PUBLIC_KEY=clave-publica-ed25519-spki-en-base64
QR_KEY_ID=smart-ticket-1

# Proveedor de correo (configura Brevo API o SMTP; no ambos son obligatorios)
BREVO_API_KEY=clave-api-de-ejemplo
BREVO_SENDER=correo-verificado@ejemplo.com
BREVO_SENDER_NAME=Smart Ticket
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario-de-ejemplo
SMTP_PASS=password-de-ejemplo
SMTP_FROM=Smart Ticket <correo-verificado@ejemplo.com>
