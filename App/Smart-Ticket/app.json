{
  "expo": {
    "name": "Smart-Ticket",
    "slug": "Smart-Ticket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/BOT-icon.png",
    "scheme": "smartticket",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/BOT-icon.png"
    },
    "android": {
      "permissions": [
        "android.permission.WRITE_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#08245B",
        "foregroundImage": "./assets/images/BOT.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.daniald.SmartTicket",
      "minSdkVersion": 26,
      "targetSdkVersion": 35,
      "compileSdkVersion": 35,
      "buildToolsVersion": "35.0.0"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F7FB",
          "image": "./assets/images/BOT-icon.png",
          "imageWidth": 170,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite que Smart Ticket use Face ID para proteger tus boletos guardados."
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8330d623-bb4d-423f-9a9e-8543aea15891"
      }
    },
    "owner": "dani-ald",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8330d623-bb4d-423f-9a9e-8543aea15891"
    }
  }
}
